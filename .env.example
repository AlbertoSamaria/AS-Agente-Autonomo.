APP_ENV=local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sa_agent
DB_USER=root
DB_PASS=

LLM_PROVIDER=ollama
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=llama.cpp

OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_TAGS_URL=http://127.0.0.1:11434/api/tags
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TEMPERATURE=0.55
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.12
OLLAMA_REPEAT_LAST_N=128
OLLAMA_NUM_PREDICT=512
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120
OLLAMA_EMBEDDING_TIMEOUT=60

LLAMACPP_BASE_URL=http://127.0.0.1:8080
LLAMACPP_MODEL=local-model
LLAMACPP_TIMEOUT=120
LLAMACPP_TEMPERATURE=0.65
LLAMACPP_TOP_P=0.90
LLAMACPP_REPEAT_PENALTY=1.18
LLAMACPP_FREQUENCY_PENALTY=0.15
LLAMACPP_PRESENCE_PENALTY=0.05
LLAMACPP_MAX_TOKENS=512
AGENT_CONTEXT_MAX_CHARS=24000

# Gemini cloud (production only; never put the real key in this example file)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=90
GEMINI_TEMPERATURE=0.55
GEMINI_TOP_P=0.9
GEMINI_MAX_OUTPUT_TOKENS=2048

# Groq cloud fallback (keep the real key only in the private .env file)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=90
GROQ_TEMPERATURE=0.55
GROQ_TOP_P=0.9
GROQ_MAX_COMPLETION_TOKENS=2048

# Embeddings
EMBEDDING_PROVIDER=ollama
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_TIMEOUT=60
